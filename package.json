{
  "name": "hermes-chat-ui",
  "productName": "Hermes Console",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "Local cinematic UI for the Hermes CLI agent",
  "author": {
    "name": "Hermes Console"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "next build && electron-builder --mac --arm64 --x64",
    "electron:pack": "next build && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.451.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.hermes.console",
    "productName": "Hermes Console",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/static",
        "to": "app.asar.unpacked/.next/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "app.asar.unpacked/.next/standalone/public"
      }
    ],
    "directories": {
      "buildResources": "electron",
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "electron/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "backgroundColor": "#07070b",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
